# ==============================================================================
# THE DAILY BRIEF — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Variables prefixed with VITE_ are embedded into the client bundle by Vite.
#   Only public keys (e.g. VITE_SUPABASE_ANON_KEY) may be prefixed with VITE_.
# - Server-side secrets (JWT_SECRET, CRON_SECRET, SUPABASE_SERVICE_ROLE_KEY)
#   must NEVER be prefixed with VITE_ and must be configured in Vercel Environment Variables.
# ==============================================================================

# 1. Environment & Server Settings
NODE_ENV=development
PORT=3001

# 2. Local SQLite Database (Local Development Only)
DATABASE_URL=data/newspaper.db

# 3. Cloud Supabase PostgreSQL (Required for Persistent Production on Vercel)
# Obtain from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Server-side Service Role Key (Keep confidential - used by backend collector & admin routes)
# Configure in Vercel Project Settings -> Environment Variables
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-service-role-key

# 4. Newsroom Admin Credentials (For Local Authentication)
ADMIN_USERNAME=editor
ADMIN_PASSWORD=your-secure-admin-password-here

# 5. Cryptographic Signing Secrets
# Generate using: openssl rand -base64 32
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-characters
CRON_SECRET=your-secure-random-cron-secret-at-least-32-characters

# 6. Background RSS Wire Ingestion Schedule (Minutes)
# Set to 0 on Vercel (where Vercel Cron triggers /api/cron/collect externally)
AUTO_COLLECT_MINUTES=30
